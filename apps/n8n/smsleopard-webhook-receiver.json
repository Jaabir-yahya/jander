              "value": "={{$json.body.message?.image?.url || ''}}",
              "type": "string"
            },
            {
              "id": "audio_url",
              "name": "message.audio.url",
              "value": "={{$json.body.message?.audio?.url || ''}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
