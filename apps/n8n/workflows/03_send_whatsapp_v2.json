      "parameters": {
        "jsCode": "// BUSINESS LOGIC: Calculate if within 24h window\n// Architecture: See docs/NATIVE_INTEGRATIONS.md\n\nconst lastMessage = $input.item.json[0];\nconst now = Date.now();\nconst lastTime = lastMessage?.created_at ? new Date(lastMessage.created_at).getTime() : 0;\nconst withinWindow = (now - lastTime) < 86400000; // 24h in ms\n\nconst input = $('Extract Input').first().json;\n\nreturn { \n  ...input,\n  withinWindow, \n  messageType: input.message_type,\n  useSession: withinWindow,\n  useTemplate: !withinWindow,\n  cost_kes: withinWindow ? 0 : 0.75\n};"
      },
