      "parameters": {
        "jsCode": "// Error Handler: Classify error for payment confirmation\n// Industry standard: Retry WhatsApp errors, log database errors\n\nconst error = $input.item.json.error || {};\nconst nodeName = $input.item.json.node?.name || 'unknown_node';\nconst errorMessage = error.message || 'Unknown error';\nconst errorCode = error.code || error.status || 'UNKNOWN';\nconst errorStack = error.stack || null;\n\n// Classify error\nlet errorType = 'NEEDS_REVIEW';\nlet severity = 'ERROR';\nlet isRetryable = false;\n\n// Retryable errors (network, rate limits, timeouts) - for WhatsApp API calls\nif (\n  errorCode === 'ECONNREFUSED' ||\n  errorCode === 'ETIMEDOUT' ||\n  errorCode === 'ENOTFOUND' ||\n  errorCode === 429 || // Rate limit\n  errorCode === 503 || // Service unavailable\n  errorCode === 502 || // Bad gateway\n  errorMessage.toLowerCase().includes('timeout') ||\n  errorMessage.toLowerCase().includes('network') ||\n  errorMessage.toLowerCase().includes('rate limit')\n) {\n  errorType = 'RETRYABLE';\n  isRetryable = true;\n} else if (\n  errorCode === 401 || // Unauthorized\n  errorCode === 403 || // Forbidden\n  errorMessage.toLowerCase().includes('unauthorized')\n) {\n  errorType = 'CRITICAL';\n  severity = 'CRITICAL';\n} else if (\n  errorCode === 400 || // Bad request\n  errorCode === 422 || // Unprocessable entity\n  errorMessage.toLowerCase().includes('validation')\n) {\n  errorType = 'NEEDS_REVIEW';\n}\n\n// Get context from previous nodes\nconst inputData = $('Extract Input').first()?.json || {};\nconst tradeId = inputData.trade_id || null;\nconst paymentId = inputData.payment_id || null;\n\nreturn {\n  error_type: errorType,\n  severity: severity,\n  is_retryable: isRetryable,\n  service_name: 'payment-confirmation',\n  error_message: errorMessage,\n  error_code: errorCode,\n  error_stack: errorStack,\n  node_name: nodeName,\n  trade_id: tradeId,\n  payment_id: paymentId,\n  context: {\n    operation: 'send_payment_confirmation',\n    node: nodeName,\n    trade_id: tradeId,\n    payment_id: paymentId\n  },\n  status_code: errorCode >= 500 ? 500 : (errorCode >= 400 ? 400 : 500),\n  max_retries: 3,\n  retry_count: 0\n};"
      },
      "id": "error-handler-classify",
      "name": "Error Handler: Classify Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 600],
      "notes": "Industry standard: Classify payment confirmation errors (retryable for WhatsApp, needs review for database)"
    },
    {
      "parameters": {
        "jsCode": "// Error Handler: Check if should retry or log\n// Industry standard: Retry WhatsApp errors, log database errors\n\nconst errorData = $input.item.json;\nconst isRetryable = errorData.is_retryable === true;\nconst retryCount = errorData.retry_count || 0;\nconst maxRetries = errorData.max_retries || 3;\nconst nodeName = errorData.node_name || '';\n\n// Only retry WhatsApp API calls, not database operations\nconst isWhatsAppCall = nodeName.includes('Notify') || nodeName.includes('WhatsApp');\n\nif (isRetryable && isWhatsAppCall && retryCount < maxRetries) {\n  // Calculate exponential backoff delay\n  const baseDelay = 1000; // 1 second\n  const delayMs = Math.min(baseDelay * Math.pow(2, retryCount), 30000); // Cap at 30s\n  const jitter = Math.random() * delayMs * 0.1; // 10% jitter\n  const finalDelay = Math.floor(delayMs + jitter);\n  \n  return {\n    should_retry: true,\n    retry_count: retryCount + 1,\n    delay_ms: finalDelay,\n    ...errorData\n  };\n} else if (isRetryable && isWhatsAppCall && retryCount >= maxRetries) {\n  // Max retries exceeded - add to DLQ\n  return {\n    should_retry: false,\n    add_to_dlq: true,\n    retry_count: retryCount,\n    max_retries_exceeded: true,\n    ...errorData\n  };\n} else {\n  // Not retryable or database error - just log\n  return {\n    should_retry: false,\n    add_to_dlq: false,\n    ...errorData\n  };\n}"
      },
