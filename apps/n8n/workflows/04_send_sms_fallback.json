      "name": "Is Transactional?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format SMS (160 chars max)\n// Architecture: See docs/WAAS_ARCHITECTURE.md (Fallback Strategy)\n\nconst message = $input.item.json.message || '';\nconst maxLength = 160;\n\nlet smsMessage = message;\nif (smsMessage.length > maxLength) {\n  smsMessage = smsMessage.substring(0, maxLength - 30) + '... Reply HELP for support';\n} else if (smsMessage.length < maxLength - 30) {\n  smsMessage += '\\n\\nReply HELP for support';\n}\n\nreturn {\n  ...$input.item.json,\n  sms_message: smsMessage\n};"
      },
      "id": "format-sms",
      "name": "Format SMS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SMS_PROVIDER === 'smsleopard' ? ($env.SMSLEOPARD_API_BASE_URL || 'https://api.smsleopard.co.ke') + '/v1/sms/send' : ($env.AFRICASTALKING_API_BASE_URL || 'https://api.africastalking.com') + '/version1/messaging'}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{$env.SMS_PROVIDER === 'smsleopard' ? 'Bearer ' + $env.SMSLEOPARD_API_KEY : 'ApiKey ' + $env.AFRICASTALKING_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "to",
              "value": "={{$json.phone}}"
            },
            {
              "name": "message",
              "value": "={{$json.sms_message}}"
            },
            {
              "name": "sender_id",
              "value": "={{$env.SMS_SENDER_ID || 'TRADEFAC'}}"
            }
          ]
        },
        "options": {}
      },
      "id": "send-sms",
      "name": "Send SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 200]
    },
