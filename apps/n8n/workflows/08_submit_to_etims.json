            },
            {
              "name": "total",
              "value": "={{$json.etimsPayload.total}}"
            },
            {
              "name": "items",
              "value": "={{JSON.stringify($json.etimsPayload.items)}}"
            }
          ]
        },
        "options": {
          "authentication": {
            "username": "={{$json.taxSystem.api_key}}",
            "password": "={{$json.taxSystem.api_secret}}"
          }
        }
      },
      "id": "submit-to-etims",
      "name": "Submit to eTIMS (KRA OSCU)",
