      "id": "get-invoice",
      "name": "Get Invoice Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 500]
    },
    {
      "parameters": {
        "jsCode": "// Extract tax system config and invoice data\nconst tenantConfig = $('Get Tenant Tax Config').first().json[0];\nconst invoice = $('Get Invoice Details').first().json[0];\n\nif (!tenantConfig || !tenantConfig.tax_system) {\n  return {\n    error: 'Tax system not configured for tenant',\n    skip: true\n  };\n}\n\nconst taxSystem = tenantConfig.tax_system;\n\n// Build eTIMS payload\nconst etimsPayload = {\n  pin: taxSystem.pin,\n  invoiceNo: invoice.invoice_id || invoice.invoice_number,\n  issueDate: invoice.issue_date || new Date().toISOString().split('T')[0],\n  totalExcl: invoice.subtotal || invoice.total_excl_vat,\n  totalTax: invoice.tax || invoice.vat_amount || 0,\n  total: invoice.total || invoice.total_amount,\n  items: invoice.items || []\n};\n\nreturn {\n  taxSystem,\n  invoice,\n  etimsPayload,\n  skip: false\n};"
      },
      "id": "prepare-etims-payload",
      "name": "Prepare eTIMS Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "skip-check",
              "leftValue": "={{$json.skip}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-if-skip",
      "name": "Check if Skip",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [850, 400]
    },
