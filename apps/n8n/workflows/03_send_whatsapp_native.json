    {
      "parameters": {
        "jsCode": "// Determine if session message or template required\n// Architecture: See docs/NATIVE_INTEGRATIONS.md\n\nconst windowData = $input.item.json[0];\nconst input = $('Extract Input').first().json;\n\nconst now = new Date();\nconst expiresAt = windowData?.conversation_window_expires_at \n  ? new Date(windowData.conversation_window_expires_at) \n  : null;\n\nconst withinWindow = expiresAt && expiresAt > now;\nconst useSession = withinWindow || input.session_allowed;\n\nreturn {\n  ...input,\n  use_session_message: useSession,\n  use_template: !useSession,\n  cost_kes: useSession ? 0 : 0.75\n};"
      },
      "id": "determine-type",
      "name": "Determine Message Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
