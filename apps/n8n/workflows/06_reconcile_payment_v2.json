      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/trades?buyer_phone=eq.{{$('Extract Payment Data').first().json.phone}}&status=in.(pending,confirmed)&select=trade_id,buyer_phone,total_amount,status&order=created_at.desc&limit=5",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_ANON_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "query-orders",
      "name": "Query Orders (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "jsCode": "// BUSINESS LOGIC: Match payment to order\n// Architecture: See docs/NATIVE_INTEGRATIONS.md\n\nconst payment = $('Extract Payment Data').first().json;\nconst orders = $input.item.json || [];\nconst tolerance = 50; // ±50 KSh\n\n// Filter orders within amount tolerance\nconst matchingOrders = orders.filter(order => {\n  const orderAmount = parseFloat(order.total_amount || 0);\n  const paymentAmount = parseFloat(payment.amount || 0);\n  return Math.abs(orderAmount - paymentAmount) <= tolerance;\n});\n\nconst matchCount = matchingOrders.length;\n\nreturn {\n  matchCount,\n  matched_order: matchCount === 1 ? matchingOrders[0] : null,\n  needs_manual_review: matchCount !== 1,\n  candidate_orders: matchingOrders.map(o => o.trade_id),\n  payment: payment\n};"
      },
      "id": "match-payment",
      "name": "Match Payment Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "is-single",
                    "leftValue": "={{$json.matchCount}}",
                    "rightValue": 1,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "auto-match"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "is-multiple",
                    "leftValue": "={{$json.matchCount}}",
                    "rightValue": 1,
                    "operator": {
                      "type": "number",
                      "operation": "gt"
                    }
                  }
                ],
                "combinator": "or"
              },
              "renameOutput": true,
              "outputKey": "manual-review"
            }
          ]
        },
        "options": {}
      },
      "id": "route-match",
      "name": "Route: Auto-Match vs Manual",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/trades?trade_id=eq.{{$json.matched_order.trade_id}}",
