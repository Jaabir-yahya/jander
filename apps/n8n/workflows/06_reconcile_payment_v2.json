              "type": "string"
            },
            {
              "id": "amount",
              "name": "amount",
              "value": "={{($json.Body?.stkCallback?.CallbackMetadata?.Item?.find(i => i.Name === 'Amount')?.Value || $json.Body?.stkCallback?.CallbackMetadata?.Item[0]?.Value) / 100}}",
              "type": "number"
            },
            {
              "id": "phone",
              "name": "phone",
              "value": "={{'+' + ($json.Body?.stkCallback?.CallbackMetadata?.Item?.find(i => i.Name === 'PhoneNumber')?.Value || $json.Body?.stkCallback?.CallbackMetadata?.Item[4]?.Value)}}",
