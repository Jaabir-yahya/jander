      "id": "get-mpesa-config",
      "name": "Get M-Pesa Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "jsCode": "// Generate M-Pesa STK Push password\nconst config = $('Get M-Pesa Config').first().json[0];\nconst input = $('Select Payment Rail').first().json;\n\nconst shortcode = config.mpesa_shortcode;\nconst passkey = config.mpesa_passkey;\nconst timestamp = new Date().toISOString().replace(/[^0-9]/g, '').slice(0, -3); // YYYYMMDDHHmmss\n\n// Generate password: Base64(Shortcode + Passkey + Timestamp)\nconst password = Buffer.from(`${shortcode}${passkey}${timestamp}`).toString('base64');\n\nreturn {\n  BusinessShortCode: shortcode,\n  Password: password,\n  Timestamp: timestamp,\n  TransactionType: 'CustomerPayBillOnline',\n  Amount: input.amount,\n  PartyA: input.customer_phone.replace(/\\+/g, '').replace(/^254/, '254'),\n  PartyB: shortcode,\n  PhoneNumber: input.customer_phone.replace(/\\+/g, '').replace(/^254/, '254'),\n  CallBackURL: `${process.env.N8N_BASE_URL || 'https://your-n8n-instance.com'}/webhook/mpesa-callback?tenant_id=${input.tenant_id}`,\n  AccountReference: input.order_id,\n  TransactionDesc: `Order payment for ${input.order_id}`,\n  consumer_key: config.mpesa_consumer_key,\n  consumer_secret: config.mpesa_consumer_secret\n};"
      },
