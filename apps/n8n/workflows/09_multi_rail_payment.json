      "id": "get-payment-rails",
      "name": "Get Payment Rails Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Select active payment rail by priority\nconst tenantConfig = $('Get Payment Rails Config').first().json[0];\nconst input = $('Extract Input').first().json;\n\nif (!tenantConfig || !tenantConfig.payment_rails) {\n  return {\n    error: 'Payment rails not configured',\n    selected_rail: null\n  };\n}\n\n// Filter enabled rails and sort by priority\nconst enabledRails = tenantConfig.payment_rails\n  .filter(rail => rail.enabled === true)\n  .sort((a, b) => (a.priority || 999) - (b.priority || 999));\n\nif (enabledRails.length === 0) {\n  return {\n    error: 'No enabled payment rails found',\n    selected_rail: null\n  };\n}\n\n// Select first enabled rail (highest priority)\nconst selectedRail = enabledRails[0];\n\nreturn {\n  selected_rail: selectedRail,\n  order_id: input.order_id,\n  amount: input.amount,\n  customer_phone: input.customer_phone,\n  tenant_id: input.tenant_id\n};"
      },
      "id": "select-payment-rail",
      "name": "Select Payment Rail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "rail-type-mpesa",
              "leftValue": "={{$json.selected_rail.rail_type}}",
              "rightValue": "mpesa",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
