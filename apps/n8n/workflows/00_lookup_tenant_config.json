    {
      "parameters": {
        "jsCode": "// BUSINESS LOGIC: Determine tenant from phone or use provided tenant_id\n// Architecture: See docs/NATIVE_INTEGRATIONS.md\n\nconst input = $('Extract Input').first().json;\nconst tenantById = $('Get Tenant by ID').first()?.json || [];\nconst sellerResult = $('Lookup by Phone (Seller)').first()?.json || [];\nconst buyerResult = $('Lookup by Phone (Buyer)').first()?.json || [];\n\n// If tenant_id provided and found, use it\nif (tenantById.length > 0) {\n  return {\n    tenant_config: tenantById[0],\n    tenant_id: tenantById[0].tenant_id,\n    found_by: 'tenant_id'\n  };\n}\n\n// Try to find tenant from seller phone\nif (sellerResult.length > 0) {\n  // Seller found, but we need to get their tenant_id\n  // For now, assume seller belongs to a tenant (you may need to add tenant_id to sellers table)\n  // This is a placeholder - adjust based on your data model\n  return {\n    tenant_id: null,\n    found_by: 'seller_phone',\n    seller_id: sellerResult[0].seller_id,\n    error: 'Tenant lookup by seller phone not fully implemented - add tenant_id to sellers table'\n  };\n}\n\n// Try to find tenant from buyer's recent trade\nif (buyerResult.length > 0 && buyerResult[0].tenant_id) {\n  // Get tenant config for this tenant_id\n  return {\n    tenant_id: buyerResult[0].tenant_id,\n    found_by: 'buyer_trade',\n    // Note: This would need another HTTP request to get full tenant config\n    // For now, return tenant_id and let caller fetch config\n  };\n}\n\n// Default: Use default tenant or return error\nreturn {\n  tenant_id: input.tenant_id || 'sme_001', // Default fallback\n  found_by: 'default',\n  warning: 'Using default tenant - tenant_id should be provided or determined from context'\n};"
      },
