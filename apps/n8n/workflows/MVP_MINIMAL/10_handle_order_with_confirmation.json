            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"tenant_id\": \"{{$json.tenant_id}}\",\n  \"customer_phone\": \"{{$json.customer_phone}}\",\n  \"direction\": \"outbound\",\n  \"message_type\": \"text\",\n  \"content\": \"{{$json.message}}\",\n  \"intent\": \"order_confirmation\"\n}",
        "options": {}
      },
