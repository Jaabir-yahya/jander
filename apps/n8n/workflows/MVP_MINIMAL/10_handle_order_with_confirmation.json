            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"tenant_id\": \"{{$('Lookup Tenant Config').first().json.tenant_id}}\",\n  \"order_number\": \"ORD-{{Date.now()}}\",\n  \"customer_phone\": \"{{$json.customer_phone}}\",\n  \"items\": {{JSON.stringify($json.items)}},\n  \"total_amount\": {{$json.total_amount}},\n  \"status\": \"pending_confirmation\",\n  \"payment_status\": \"unpaid\"\n}",
        "options": {}
      },
      "id": "create-order",
      "name": "Create Draft Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 300],
      "notes": "Create order with status='pending_confirmation' (Interakt pattern)"
    },
    {
      "parameters": {
        "jsCode": "// Format order confirmation message (Interakt pattern)\n// Reference: docs/core/verified-research-findings.md - Interakt success pattern\n\nconst order = $input.item.json;\nconst items = order.items || [];\n\n// Format items list\nlet itemsText = '';\nitems.forEach((item, index) => {\n  itemsText += `${index + 1}. ${item.name || item.product} - ${item.qty || 1} × KSh ${item.price || 0}\\n`;\n});\n\nconst message = `📦 Order #${order.order_number}\n\n${itemsText}\n💰 Total: KSh ${order.total_amount}\n\nReply CONFIRM to proceed with payment.`;\n\nreturn {\n  order_id: order.id,\n  order_number: order.order_number,\n  customer_phone: order.customer_phone,\n  message: message,\n  tenant_id: order.tenant_id\n};"
      },
      "id": "format-confirmation",
      "name": "Format Confirmation Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300],
      "notes": "Interakt pattern: Show order summary + CONFIRM prompt"
    },
    {
      "parameters": {
        "workflowId": "={{$env.N8N_WORKFLOW_SEND_WHATSAPP || '03_send_whatsapp_v2'}}",
        "options": {}
      },
