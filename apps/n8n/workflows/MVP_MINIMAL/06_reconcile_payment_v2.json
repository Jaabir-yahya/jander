    {
      "parameters": {
        "jsCode": "// Phase 3.2: Validate Webhook Timestamp (Replay Attack Prevention)\n// Production security: Reject webhooks older than 5 minutes\n\nconst input = $input.item.json;\nconst transactionDate = input.transaction_date;\n\nif (!transactionDate) {\n  return {\n    valid: false,\n    error: 'Missing transaction timestamp',\n    statusCode: 400,\n    security_event: 'missing_timestamp'\n  };\n}\n\n// M-Pesa timestamp format: YYYYMMDDHHmmss (e.g., 20260109120000)\n// Convert to Date object\nlet webhookTime;\ntry {\n  if (typeof transactionDate === 'string' && transactionDate.length === 14) {\n    // M-Pesa format: YYYYMMDDHHmmss\n    const year = transactionDate.substring(0, 4);\n    const month = transactionDate.substring(4, 6) - 1; // 0-indexed\n    const day = transactionDate.substring(6, 8);\n    const hour = transactionDate.substring(8, 10);\n    const minute = transactionDate.substring(10, 12);\n    const second = transactionDate.substring(12, 14);\n    webhookTime = new Date(year, month, day, hour, minute, second);\n  } else {\n    webhookTime = new Date(transactionDate);\n  }\n} catch (e) {\n  return {\n    valid: false,\n    error: 'Invalid timestamp format',\n    statusCode: 400,\n    security_event: 'invalid_timestamp_format'\n  };\n}\n\nconst now = new Date();\nconst diffMinutes = (now - webhookTime) / (1000 * 60);\n\n// Reject webhooks older than 5 minutes (M-Pesa sends within seconds)\nif (diffMinutes > 5) {\n  return {\n    valid: false,\n    error: 'Webhook timestamp too old (possible replay attack)',\n    statusCode: 401,\n    security_event: 'replay_attack',\n    age_minutes: diffMinutes.toFixed(2)\n  };\n}\n\n// Reject future timestamps (clock skew protection)\nif (diffMinutes < -1) {\n  return {\n    valid: false,\n    error: 'Webhook timestamp in future (clock skew)',\n    statusCode: 400,\n    security_event: 'future_timestamp'\n  };\n}\n\nreturn {\n  valid: true,\n  timestamp_valid: true,\n  age_minutes: diffMinutes.toFixed(2),\n  ...input\n};"
      },
