    {
      "parameters": {
        "jsCode": "// Check if exact match found\n// Use UUID tenant_id from Extract Tenant UUID node\nconst exactMatch = $input.item.json || [];\nconst tenantData = $('Extract Tenant UUID').first().json;\n\nif (exactMatch.length > 0 && exactMatch[0].confidence === 1.0) {\n  return {\n    match_found: true,\n    match_type: 'exact',\n    order_id: exactMatch[0].order_id,\n    confidence: 1.0,\n    tenant_id: tenantData.tenant_id,  // UUID\n    webhook_id: tenantData.webhook_id,\n    receipt: tenantData.receipt,\n    amount: tenantData.amount,\n    phone: tenantData.phone,\n    timestamp: tenantData.timestamp\n  };\n}\n\nreturn {\n  match_found: false,\n  match_type: null,\n  tenant_id: tenantData.tenant_id,  // UUID\n  webhook_id: tenantData.webhook_id,\n  receipt: tenantData.receipt,\n  amount: tenantData.amount,\n  phone: tenantData.phone,\n  timestamp: tenantData.timestamp\n};"
      },
