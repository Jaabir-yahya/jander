    {
      "parameters": {
        "jsCode": "// Check fuzzy match result\n// Use UUID tenant_id from Extract Tenant UUID node\nconst fuzzyMatch = $input.item.json || [];\nconst input = $('Check Exact Match').first().json;\n\nif (fuzzyMatch.length > 0) {\n  const match = fuzzyMatch[0];\n  const confidence = parseFloat(match.confidence || 0);\n  \n  if (confidence >= 0.95) {\n    return {\n      match_found: true,\n      match_type: 'fuzzy_auto',\n      order_id: match.order_id,\n      confidence: confidence,\n      tenant_id: input.tenant_id,  // UUID\n      webhook_id: input.webhook_id,\n      receipt: input.receipt,\n      amount: input.amount,\n      phone: input.phone,\n      timestamp: input.timestamp\n    };\n  } else if (confidence >= 0.85) {\n    return {\n      match_found: true,\n      match_type: 'fuzzy_review',\n      order_id: match.order_id,\n      confidence: confidence,\n      tenant_id: input.tenant_id,  // UUID\n      webhook_id: input.webhook_id,\n      receipt: input.receipt,\n      amount: input.amount,\n      phone: input.phone,\n      timestamp: input.timestamp\n    };\n  }\n}\n\nreturn {\n  match_found: false,\n  match_type: 'no_match',\n  tenant_id: input.tenant_id,  // UUID\n  webhook_id: input.webhook_id,\n  receipt: input.receipt,\n  amount: input.amount,\n  phone: input.phone,\n  timestamp: input.timestamp\n};"
