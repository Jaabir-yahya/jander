        "jsCode": "// Extract UUID tenant_id from lookup result\n// Production hardening: Always use UUID tenant_id for database operations\nconst lookupResult = $input.item.json;\nconst validated = $('Validate Input').first().json;\nconst webhookData = $('Extract Webhook Data').first().json;\n\nif (!lookupResult.tenant_id) {\n  return {\n    valid: false,\n    error: 'Tenant lookup failed',\n    statusCode: 404\n  };\n}\n\n// Use UUID tenant_id from lookup (always UUID)\n// Merge all data for downstream operations\nreturn {\n  tenant_id: lookupResult.tenant_id,  // UUID (from lookup)\n  tenant_id_input: validated.tenant_id,  // Original input (for logging)\n  webhook_id: validated.webhook_id || webhookData.webhook_id,\n  result_code: validated.result_code || webhookData.result_code,\n  receipt: validated.receipt || webhookData.receipt,\n  amount: validated.amount || webhookData.amount,\n  phone: validated.phone || webhookData.phone,\n  timestamp: validated.timestamp || webhookData.timestamp,\n  transaction_date: validated.transaction_date || webhookData.transaction_date\n};"
