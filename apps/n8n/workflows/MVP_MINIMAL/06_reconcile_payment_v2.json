    {
      "parameters": {
        "jsCode": "// Phase 3: M-Pesa Webhook Signature Verification\n// Production hardening: Verify webhook signature to prevent unauthorized requests\n// Reference: M-Pesa Daraja API security requirements\n\nconst crypto = require('crypto');\nconst input = $input.item.json;\nconst headers = input.headers || {};\nconst rawBody = input.raw_body || JSON.stringify(input);\n\n// M-Pesa sends signature in X-B2C-Signature header (or X-Callback-Signature for STK)\nconst receivedSignature = headers['X-B2C-Signature'] \n  || headers['x-b2c-signature']\n  || headers['X-Callback-Signature']\n  || headers['x-callback-signature'];\n\nconst consumerSecret = process.env.MPESA_CONSUMER_SECRET;\n\nif (!receivedSignature) {\n  return {\n    valid: false,\n    error: 'Missing X-B2C-Signature header',\n    statusCode: 401,\n    security_event: 'missing_signature'\n  };\n}\n\nif (!consumerSecret) {\n  return {\n    valid: false,\n    error: 'MPESA_CONSUMER_SECRET not configured',\n    statusCode: 500,\n    security_event: 'config_error'\n  };\n}\n\n// M-Pesa signature: Base64(HMAC-SHA256(payload, consumer_secret))\nconst payloadString = typeof rawBody === 'string' ? rawBody : JSON.stringify(rawBody);\n\nconst expectedSignature = crypto\n  .createHmac('sha256', consumerSecret)\n  .update(payloadString)\n  .digest('base64');\n\n// Constant-time comparison (prevent timing attacks)\nlet isValid = false;\ntry {\n  isValid = crypto.timingSafeEqual(\n    Buffer.from(receivedSignature),\n    Buffer.from(expectedSignature)\n  );\n} catch (e) {\n  // Signature length mismatch\n  isValid = false;\n}\n\nif (!isValid) {\n  return {\n    valid: false,\n    error: 'Invalid M-Pesa signature',\n    statusCode: 401,\n    security_event: 'invalid_signature',\n    received_sig: receivedSignature.substring(0, 20) + '...',\n    expected_sig: expectedSignature.substring(0, 20) + '...'\n  };\n}\n\nreturn {\n  valid: true,\n  signature_verified: true,\n  ...input\n};"
      },
      "id": "verify-signature",
      "name": "Verify M-Pesa Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300],
      "notes": "Production security: Verify M-Pesa webhook signature. Reject if invalid (401)."
    },
