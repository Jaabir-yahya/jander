              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "check-seller",
      "name": "Check Seller",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "jsCode": "// BUSINESS LOGIC: Determine user type and conversation window\n// Architecture: See docs/NATIVE_INTEGRATIONS.md\n\nconst buyerResult = $('Check Buyer').first()?.json || [];\nconst sellerResult = $('Check Seller').first()?.json || [];\nconst conversationData = $('Query Conversation State').first()?.json || [];\nconst messageData = $input.item.json;\n\nlet userType = 'new_user';\nif (sellerResult.length > 0) {\n  userType = 'seller';\n} else if (buyerResult.length > 0) {\n  userType = 'buyer';\n}\n\n// Check conversation window (24h from last message)\nconst conversation = conversationData[0];\nconst now = new Date();\nconst expiresAt = conversation?.conversation_window_expires_at \n  ? new Date(conversation.conversation_window_expires_at) \n  : null;\nconst sessionAllowed = expiresAt && expiresAt > now;\n\n// Determine priority\nlet priority = 'low';\nif (['order', 'payment_query'].includes(messageData.message_type)) {\n  priority = 'high';\n} else if (['status_query', 'support'].includes(messageData.message_type)) {\n  priority = 'medium';\n}\n\n// Determine fallback allowed\nconst fallbackAllowed = ['order', 'payment_query', 'status_query'].includes(messageData.message_type);\n\nreturn {\n  ...messageData,\n  user_type: userType,\n  priority: priority,\n  session_allowed: sessionAllowed,\n  fallback_allowed: fallbackAllowed\n};"
      },
      "id": "determine-user",
      "name": "Determine User Type & Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
