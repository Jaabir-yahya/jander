      "id": "extract-message",
      "name": "Extract Message Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// BUSINESS LOGIC: Classify message type\n// Architecture: See docs/NATIVE_INTEGRATIONS.md\n\nconst text = ($input.item.json.message_text || '').toLowerCase();\nlet messageType = 'unknown';\n\n// Order keywords (English, Swahili, Sheng)\nif (text.match(/order|nataka|taka|nimtaki|buy|want|nunua/i)) {\n  messageType = 'order';\n}\n// Payment query\nelse if (text.match(/payment|paid|pesa|lipa|malipo/i)) {\n  messageType = 'payment_query';\n}\n// Status query\nelse if (text.match(/status|where|delivery|wapi|hali/i)) {\n  messageType = 'status_query';\n}\n// Support\nelse if (text.match(/help|support|saaidie|msaada|assist/i)) {\n  messageType = 'support';\n}\n\nreturn { \n  message_type: messageType, \n  ...$input.item.json \n};"
      },
      "id": "classify-type",
      "name": "Classify Message Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/conversations?phone=eq.{{$json.phone}}&select=conversation_window_expires_at,last_message_at&order=last_message_at.desc&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
