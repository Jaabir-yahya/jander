{
  "name": "19_revenue_collection_enforcer",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 20 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Cron Trigger (Daily 8 PM)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1.1,
      "position": [250, 300],
      "notes": "Daily at 8 PM. Reference: docs/core/PRODUCTION_BLUEPRINT.md Step 2"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/orders?payment_status=neq.paid&created_at=lt.{{new Date(Date.now() - 24*60*60*1000).toISOString()}}&select=id,tenant_id,customer_phone,amount,created_at,reminder_count,last_reminder_at&order=created_at.asc",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_ANON_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Range",
              "value": "0-999"
            }
          ]
        },
        "options": {}
      },
      "id": "query-unpaid-orders",
      "name": "Query Unpaid Orders >24h",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300],
      "notes": "Get unpaid orders older than 24 hours. Reference: docs/core/PRODUCTION_BLUEPRINT.md Step 2"
    },
    {
      "parameters": {
        "jsCode": "// Process each unpaid order\n// Calculate reminder level and message\nconst orders = Array.isArray($input.all()) ? $input.all() : [$input.item.json];\n\nreturn orders.map(order => {\n  const reminderCount = order.reminder_count || 0;\n  const orderAge = Math.floor((Date.now() - new Date(order.created_at).getTime()) / (1000 * 60 * 60)); // hours\n  \n  let reminderLevel = 'polite';\n  let message = `Hi! Just a friendly reminder about your order #${order.id.substring(0, 8)} for KSh ${order.amount}. Please complete payment when convenient. Asante!`;\n  let priority = 'medium';\n  \n  if (reminderCount === 1) {\n    reminderLevel = 'urgent';\n    message = `⚠️ Urgent: Your order #${order.id.substring(0, 8)} for KSh ${order.amount} is still pending payment. Please pay within 24 hours to avoid cancellation.`;\n    priority = 'high';\n  } else if (reminderCount === 2) {\n    reminderLevel = 'final';\n    message = `🚨 Final Notice: Order #${order.id.substring(0, 8)} for KSh ${order.amount} will be cancelled if payment is not received within 12 hours.`;\n    priority = 'high';\n  } else if (reminderCount >= 3) {\n    reminderLevel = 'escalate';\n    message = `Account suspended. Please contact support to arrange payment plan for order #${order.id.substring(0, 8)}.`;\n    priority = 'critical';\n  }\n  \n  return {\n    ...order,\n    reminderLevel,\n    message,\n    priority,\n    shouldEscalate: reminderCount >= 3,\n    newReminderCount: reminderCount + 1\n  };\n});"
      },
      "id": "process-orders",
      "name": "Process Orders & Generate Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300],
      "notes": "Calculate reminder level and message based on reminder count"
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "should-escalate",
                    "leftValue": "={{$json.shouldEscalate}}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    }
                  }
                ],
                "combinator": "or"
              },
              "renameOutput": true,
              "outputKey": "escalate"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "should-not-escalate",
                    "leftValue": "={{$json.shouldEscalate}}",
                    "rightValue": false,
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    }
                  }
                ],
                "combinator": "or"
              },
              "renameOutput": true,
              "outputKey": "send-reminder"
            }
          ]
        },
        "options": {}
      },
      "id": "route-orders",
      "name": "Route: Escalate vs Send Reminder",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [850, 300],
      "notes": "Route orders: escalate (3+ reminders) vs send reminder"
    },
    {
      "parameters": {
        "workflowId": "03_send_whatsapp_v2",
        "options": {}
      },
      "id": "send-reminder",
      "name": "Send Payment Reminder",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1050, 400],
      "notes": "Send WhatsApp reminder using 03_send_whatsapp_v2 workflow"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/orders?id=eq.{{$json.id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_ANON_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"reminder_count\": {{$json.newReminderCount}},\n  \"last_reminder_at\": \"{{new Date().toISOString()}}\"\n}",
        "options": {}
      },
      "id": "update-order",
      "name": "Update Order Reminder Count",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 400],
      "notes": "Update order with new reminder count and timestamp"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/support_cases",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_ANON_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
