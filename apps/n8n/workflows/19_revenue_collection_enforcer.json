        "jsonBody": "={\n  \"tenant_id\": \"{{$json.tenant_id}}\",\n  \"case_type\": \"billing\",\n  \"priority\": \"{{$json.priority}}\",\n  \"status\": \"open\",\n  \"automated\": true,\n  \"description\": \"Payment reminder escalated: Order #{{$json.id.substring(0, 8)}} for KSh {{$json.amount}} has {{$json.newReminderCount}} reminders. Customer: {{$json.customer_phone}}\",\n  \"assigned_to\": \"system\"\n}",
        "options": {}
      },
      "id": "create-support-case",
      "name": "Create Support Case (Escalated)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 200],
      "notes": "Create support case for escalated payment reminders. Reference: docs/core/PRODUCTION_BLUEPRINT.md Step 2"
    },
    {
      "parameters": {
        "jsCode": "// Summary of processed orders\nconst allOrders = $input.all();\nconst sent = allOrders.filter(o => !o.shouldEscalate).length;\nconst escalated = allOrders.filter(o => o.shouldEscalate).length;\n\nreturn {\n  processed: allOrders.length,\n  reminders_sent: sent,\n  escalated: escalated,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "generate-summary",
      "name": "Generate Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 300],
      "notes": "Generate summary of processed orders"
    }
