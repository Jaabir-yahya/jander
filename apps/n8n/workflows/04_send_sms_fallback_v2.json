    {
      "parameters": {
        "jsCode": "// BUSINESS LOGIC: Only SMS fallback for transactional messages\n// Architecture: See docs/NATIVE_INTEGRATIONS.md\n\nconst input = $input.item.json;\n\n// Check if fallback is allowed\nif (input.reason !== 'whatsapp_timeout' && input.reason !== 'whatsapp_failed') {\n  return { allowed: false, reason: 'invalid_reason' };\n}\n\n// Marketing messages should not fallback to SMS\nif (input.message_type === 'marketing') {\n  return { allowed: false, reason: 'marketing_no_fallback' };\n}\n\n// Transactional messages can fallback\nif (['order', 'payment_query', 'status_query', 'transactional'].includes(input.message_type)) {\n  return { allowed: true, ...input };\n}\n\nreturn { allowed: false, reason: 'unknown_message_type' };"
      },
      "id": "check-type",
      "name": "Check Message Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-allowed",
              "leftValue": "={{$json.allowed}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-allowed",
      "name": "Fallback Allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format SMS (160 chars max)\n// Architecture: See docs/NATIVE_INTEGRATIONS.md\n\nconst message = $input.item.json.message || '';\nconst maxLength = 160;\n\nlet smsMessage = message;\nif (smsMessage.length > maxLength) {\n  smsMessage = smsMessage.substring(0, maxLength - 30) + '... Reply HELP for support';\n} else if (smsMessage.length < maxLength - 30) {\n  smsMessage += '\\n\\nReply HELP for support';\n}\n\nreturn {\n  ...$input.item.json,\n  sms_message: smsMessage\n};"
      },
      "id": "format-sms",
      "name": "Format SMS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 200]
    },
